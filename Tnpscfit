    <!-- JavaScript Logic -->
    <script>
        // State Variables
        let currentPhotoImg = null;
        let currentSignImg = null;
        let photoBlobData = null;
        let signBlobData = null;
        let isDrawing = false;

        // Canvas elements
        const photoCanvas = document.getElementById('photo-canvas');
        const photoCtx = photoCanvas.getContext('2d');
        const signCanvas = document.getElementById('sign-canvas');
        const signCtx = signCanvas.getContext('2d');
        const signPad = document.getElementById('sign-pad');
        const signPadCtx = signPad.getContext('2d');

        // Initial default Date setup (Today)
        const todayStr = new Date().toISOString().split('T')[0];
        document.getElementById('photo-date-input').value = todayStr;

        // Setup Signature Pad resolution
        function setupSignaturePad() {
            const rect = signPad.getBoundingClientRect();
            signPad.width = rect.width * 2;
            signPad.height = rect.height * 2;
            signPadCtx.scale(2, 2);
            signPadCtx.lineCap = 'round';
            signPadCtx.lineJoin = 'round';
            signPadCtx.lineWidth = 2.5;
            signPadCtx.strokeStyle = '#000000';
            clearSignaturePad();
        }

        function clearSignaturePad() {
            signPadCtx.fillStyle = '#ffffff';
            signPadCtx.fillRect(0, 0, signPad.width, signPad.height);
            renderSignaturePreview();
        }

        // Tab Switching
        function switchTab(tab) {
            const photoBtn = document.getElementById('tab-photo-btn');
            const signBtn = document.getElementById('tab-sign-btn');
            const photoSec = document.getElementById('photo-section');
            const signSec = document.getElementById('sign-section');

            if (tab === 'photo') {
                photoSec.classList.remove('hidden');
                signSec.classList.add('hidden');
                photoBtn.className = "flex items-center gap-2.5 px-6 py-3 font-semibold text-sm rounded-t-xl transition-all border-b-2 border-emerald-600 bg-white text-emerald-700 shadow-sm";
                signBtn.className = "flex items-center gap-2.5 px-6 py-3 font-semibold text-sm rounded-t-xl transition-all border-b-2 border-transparent text-slate-500 hover:text-slate-800 hover:bg-slate-100";
            } else {
                photoSec.classList.add('hidden');
                signSec.classList.remove('hidden');
                signBtn.className = "flex items-center gap-2.5 px-6 py-3 font-semibold text-sm rounded-t-xl transition-all border-b-2 border-emerald-600 bg-white text-emerald-700 shadow-sm";
                photoBtn.className = "flex items-center gap-2.5 px-6 py-3 font-semibold text-sm rounded-t-xl transition-all border-b-2 border-transparent text-slate-500 hover:text-slate-800 hover:bg-slate-100";
                setTimeout(setupSignaturePad, 50);
            }
        }

        // Signature Mode Switch
        function setSignMode(mode) {
            const upContainer = document.getElementById('sign-upload-container');
            const drawContainer = document.getElementById('sign-draw-container');
            const upBtn = document.getElementById('sign-mode-upload');
            const drawBtn = document.getElementById('sign-mode-draw');

            if (mode === 'upload') {
                upContainer.classList.remove('hidden');
                drawContainer.classList.add('hidden');
                upBtn.className = "py-2 text-xs font-bold rounded-lg bg-white shadow-sm text-emerald-700 transition";
                drawBtn.className = "py-2 text-xs font-semibold rounded-lg text-slate-600 hover:text-slate-900 transition";
            } else {
                upContainer.classList.add('hidden');
                drawContainer.classList.remove('hidden');
                drawBtn.className = "py-2 text-xs font-bold rounded-lg bg-white shadow-sm text-emerald-700 transition";
                upBtn.className = "py-2 text-xs font-semibold rounded-lg text-slate-600 hover:text-slate-900 transition";
                setupSignaturePad();
            }
        }

        // ==========================================
        // PHOTO GENERATION & RENDERING
        // ==========================================
        function renderPhoto() {
            const resType = document.getElementById('photo-res-select').value;
            let targetW = 276;
            let targetH = 354;
            if (resType === 'portal') {
                targetW = 130;
                targetH = 170;
            }

            photoCanvas.width = targetW;
            photoCanvas.height = targetH;

            // 1. Fill solid White background (TNPSC standard requirement)
            photoCtx.fillStyle = '#ffffff';
            photoCtx.fillRect(0, 0, targetW, targetH);

            const bottomBannerHeight = Math.round(targetH * 0.22); // ~22% for Name & Date box
            const photoAreaHeight = targetH - bottomBannerHeight;

            // 2. Draw user photo if loaded
            if (currentPhotoImg) {
                const zoom = parseInt(document.getElementById('photo-zoom').value) / 100;
                const offsetX = parseInt(document.getElementById('photo-offset-x').value);
                const offsetY = parseInt(document.getElementById('photo-offset-y').value);

                // Calculate aspect ratio covering photoAreaHeight
                const imgRatio = currentPhotoImg.width / currentPhotoImg.height;
                const areaRatio = targetW / photoAreaHeight;
                let drawW, drawH;

                if (imgRatio > areaRatio) {
                    drawH = photoAreaHeight * zoom;
                    drawW = drawH * imgRatio;
                } else {
                    drawW = targetW * zoom;
                    drawH = drawW / imgRatio;
                }

                const posX = (targetW - drawW) / 2 + offsetX;
                const posY = (photoAreaHeight - drawH) / 2 + offsetY;

                // Save context & clip to avoid spilling into bottom banner
                photoCtx.save();
                photoCtx.beginPath();
                photoCtx.rect(0, 0, targetW, photoAreaHeight);
                photoCtx.clip();
                photoCtx.drawImage(currentPhotoImg, posX, posY, drawW, drawH);
                photoCtx.restore();
            } else {
                // Placeholder avatar sketch if no image
                photoCtx.fillStyle = '#e2e8f0';
                photoCtx.fillRect(0, 0, targetW, photoAreaHeight);
                photoCtx.fillStyle = '#94a3b8';
                photoCtx.font = `${Math.round(targetW * 0.06)}px Inter, sans-serif`;
                photoCtx.textAlign = 'center';
                photoCtx.fillText("போட்டோ அப்லோடு செய்க", targetW / 2, photoAreaHeight / 2);
            }

            // 3. Draw Bottom Banner for Name & Date (TNPSC Strict Specification)
            photoCtx.fillStyle = '#ffffff';
            photoCtx.fillRect(0, photoAreaHeight, targetW, bottomBannerHeight);

            // Thin separation line
            photoCtx.strokeStyle = '#000000';
            photoCtx.lineWidth = 1.2;
            photoCtx.beginPath();
            photoCtx.moveTo(0, photoAreaHeight);
            photoCtx.lineTo(targetW, photoAreaHeight);
            photoCtx.stroke();

            // Name & Date text
            const name = (document.getElementById('photo-name-input').value || 'YOUR NAME').trim().toUpperCase();
            const rawDate = document.getElementById('photo-date-input').value;
            let formattedDate = 'DD-MM-YYYY';
            if (rawDate) {
                const parts = rawDate.split('-');
                if (parts.length === 3) {
                    formattedDate = `${parts[2]}-${parts[1]}-${parts[0]}`; // DD-MM-YYYY format
                }
            }

            photoCtx.fillStyle = '#000000';
            photoCtx.textAlign = 'center';
            photoCtx.textBaseline = 'middle';

            // Adaptive font sizes for Name & Date
            const nameFontSize = Math.max(11, Math.round(targetW * 0.055));
            const dateFontSize = Math.max(10, Math.round(targetW * 0.050));

            photoCtx.font = `bold ${nameFontSize}px Arial, sans-serif`;
            photoCtx.fillText(name, targetW / 2, photoAreaHeight + (bottomBannerHeight * 0.35));

            photoCtx.font = `600 ${dateFontSize}px Arial, sans-serif`;
            photoCtx.fillText(formattedDate, targetW / 2, photoAreaHeight + (bottomBannerHeight * 0.72));

            // Outer border for canvas
            photoCtx.strokeStyle = '#94a3b8';
            photoCtx.lineWidth = 1;
            photoCtx.strokeRect(0, 0, targetW, targetH);

            // 4. Compress to 20 KB - 50 KB strict requirement
            compressPhotoToTNPSCSize();
        }

        // Automatic binary compression algorithm to guarantee 20KB - 50KB range
        function compressPhotoToTNPSCSize() {
            let minQuality = 0.5;
            let maxQuality = 0.98;
            let bestBlob = null;
            let bestQuality = 0.85;

            // Recursive / iterative quality adjustment to hit ~30KB - 40KB ideally
            function testQuality(q, attempts) {
                photoCanvas.toBlob((blob) => {
                    if (!blob) return;
                    const sizeKB = blob.size / 1024;
                    
                    if (sizeKB >= 20 && sizeKB <= 50) {
                        bestBlob = blob;
                        updatePhotoSizeBadge(sizeKB, true);
                        photoBlobData = blob;
                        return;
                    }

                    if (attempts <= 0) {
                        // Accept closest
                        bestBlob = blob;
                        photoBlobData = blob;
                        updatePhotoSizeBadge(sizeKB, sizeKB >= 20 && sizeKB <= 50);
                        return;
                    }

                    if (sizeKB < 20) {
                        // File is too small, increase quality
                        minQuality = q;
                        bestQuality = (minQuality + maxQuality) / 2;
                        testQuality(bestQuality, attempts - 1);
                    } else if (sizeKB > 50) {
                        // File too large, decrease quality
                        maxQuality = q;
                        bestQuality = (minQuality + maxQuality) / 2;
                        testQuality(bestQuality, attempts - 1);
                    }
                }, 'image/jpeg', q);
            }

            testQuality(bestQuality, 5);
        }

        function updatePhotoSizeBadge(sizeKB, isValid) {
            const badge = document.getElementById('photo-size-badge');
            const progress = document.getElementById('photo-size-progress');
            const msg = document.getElementById('photo-size-msg');
            const rounded = sizeKB.toFixed(1);

            badge.textContent = `${rounded} KB`;

            // Progress bar mapping (0 KB to 60 KB range)
            const percent = Math.min(100, Math.max(5, (sizeKB / 50) * 100));
            progress.style.width = `${percent}%`;

            if (sizeKB >= 20 && sizeKB <= 50) {
                badge.className = "px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300";
                progress.className = "bg-emerald-600 h-full transition-all duration-300";
                msg.innerHTML = `<span class="text-emerald-700 font-semibold"><i class="fa-solid fa-circle-check mr-1"></i>அளவு சரியாக உள்ளது (TNPSC வரம்பு: 20 KB - 50 KB). பதிவிறக்கம் செய்யலாம்!</span>`;
            } else if (sizeKB < 20) {
                badge.className = "px-2 py-0.5 rounded text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300";
                progress.className = "bg-amber-500 h-full transition-all duration-300";
                msg.innerHTML = `<span class="text-amber-700"><i class="fa-solid fa-circle-info mr-1"></i>அளவு 20 KB ஐ விட சற்று குறைவாக உள்ளது. போட்டோ Zoom அல்லது தெளிவை அதிகரிக்கலாம்.</span>`;
            } else {
                badge.className = "px-2 py-0.5 rounded text-xs font-bold bg-red-100 text-red-800 border border-red-300";
                progress.className = "bg-red-500 h-full transition-all duration-300";
                msg.innerHTML = `<span class="text-red-700"><i class="fa-solid fa-circle-exclamation mr-1"></i>அளவு 50 KB ஐ விட அதிகம். சுருக்கப்படுகிறது...</span>`;
            }
        }

        // ==========================================
        // SIGNATURE GENERATION & RENDERING
        // ==========================================
        function renderSignaturePreview() {
            // TNPSC standard dimension: 230 x 75 px (6.0cm x 2.0cm)
            signCanvas.width = 230;
            signCanvas.height = 75;

            // Fill pure white backdrop
            signCtx.fillStyle = '#ffffff';
            signCtx.fillRect(0, 0, 230, 75);

            const isDrawMode = !document.getElementById('sign-draw-container').classList.contains('hidden');
            const applyBW = document.getElementById('sign-bw-filter').checked;
            const threshold = parseInt(document.getElementById('sign-threshold').value);

            if (isDrawMode) {
                // Source is drawn signature pad
                signCtx.drawImage(signPad, 0, 0, 230, 75);
            } else if (currentSignImg) {
                // Source is uploaded image
                const imgRatio = currentSignImg.width / currentSignImg.height;
                const canvasRatio = 230 / 75;
                let drawW = 230;
                let drawH = 75;

                if (imgRatio > canvasRatio) {
                    drawW = 230;
                    drawH = 230 / imgRatio;
                } else {
                    drawH = 75;
                    drawW = 75 * imgRatio;
                }

                const posX = (230 - drawW) / 2;
                const posY = (75 - drawH) / 2;

                signCtx.drawImage(currentSignImg, posX, posY, drawW, drawH);
            } else {
                signCtx.fillStyle = '#94a3b8';
                signCtx.font = "12px Inter, sans-serif";
                signCtx.textAlign = 'center';
                signCtx.textBaseline = 'middle';
                signCtx.fillText("கையெழுத்தை உள்ளிடவும்", 115, 37.5);
            }

            // High Contrast Binarization / Black Ink enhancer
            if (applyBW && (currentSignImg || isDrawMode)) {
                const imgData = signCtx.getImageData(0, 0, 230, 75);
                const data = imgData.data;

                for (let i = 0; i < data.length; i += 4) {
                    const r = data[i];
                    const g = data[i + 1];
                    const b = data[i + 2];
                    // Grayscale luminance
                    const gray = 0.299 * r + 0.587 * g + 0.114 * b;

                    // Clean white background, make signature dark/crisp
                    if (gray > threshold) {
                        data[i] = 255;
                        data[i + 1] = 255;
                        data[i + 2] = 255;
                    } else {
                        data[i] = 10;
                        data[i + 1] = 10;
                        data[i + 2] = 20;
                    }
                }
                signCtx.putImageData(imgData, 0, 0);
            }

            // Border
            signCtx.strokeStyle = '#cbd5e1';
            signCtx.lineWidth = 1;
            signCtx.strokeRect(0, 0, 230, 75);

            // Compress to 10 KB - 20 KB
            compressSignToTNPSCSize();
        }

        // Strict 10 KB - 20 KB Compressor
        function compressSignToTNPSCSize() {
            let quality = 0.88;

            function testSignQuality(q, tries) {
                signCanvas.toBlob((blob) => {
                    if (!blob) return;
                    const sizeKB = blob.size / 1024;
                    signBlobData = blob;

                    const badge = document.getElementById('sign-size-badge');
                    const progress = document.getElementById('sign-size-progress');
                    const msg = document.getElementById('sign-size-msg');
                    const rounded = sizeKB.toFixed(1);

                    badge.textContent = `${rounded} KB`;
                    const percent = Math.min(100, (sizeKB / 20) * 100);
                    progress.style.width = `${percent}%`;

                    if (sizeKB >= 10 && sizeKB <= 20) {
                        badge.className = "px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300";
                        progress.className = "bg-emerald-600 h-full transition-all duration-300";
                        msg.innerHTML = `<span class="text-emerald-700 font-semibold"><i class="fa-solid fa-circle-check mr-1"></i>சரியான அளவு (10 KB - 20 KB)! பதிவிறக்கம் செய்யலாம்.</span>`;
                    } else if (sizeKB < 10) {
                        badge.className = "px-2 py-0.5 rounded text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300";
                        progress.className = "bg-amber-500 h-full transition-all duration-300";
                        msg.innerHTML = `<span class="text-amber-700"><i class="fa-solid fa-circle-info mr-1"></i>அளவு: ${rounded} KB. (விதிமுறை: 10KB - 20KB). JPG தரத்தை கூட்டி சரிசெய்கிறோம்.</span>`;
                        if (tries > 0 && q < 0.99) {
                            testSignQuality(Math.min(1.0, q + 0.05), tries - 1);
                        }
                    } else {
                        badge.className = "px-2 py-0.5 rounded text-xs font-bold bg-red-100 text-red-800 border border-red-300";
                        progress.className = "bg-red-500 h-full transition-all duration-300";
                        msg.innerHTML = `<span class="text-red-700"><i class="fa-solid fa-circle-exclamation mr-1"></i>அளவு 20 KB ஐ விட அதிகம். சுருக்கப்படுகிறது...</span>`;
                        if (tries > 0 && q > 0.3) {
                            testSignQuality(q - 0.1, tries - 1);
                        }
                    }
                }, 'image/jpeg', q);
            }

            testSignQuality(quality, 4);
        }

        // ==========================================
        // SMART WHITE BACKDROP & AI FILTER
        // ==========================================
        function autoRemoveBackdrop() {
            if (!currentPhotoImg) {
                showToast("முதலில் ஒரு புகைப்படத்தை அப்லோடு செய்யவும்!", "error");
                return;
            }

            // Create temporary canvas for threshold background removal
            const tempCanvas = document.createElement('canvas');
            const tempCtx = tempCanvas.getContext('2d');
            tempCanvas.width = photoCanvas.width;
            tempCanvas.height = photoCanvas.height;

            // Draw current photo
            tempCtx.drawImage(photoCanvas, 0, 0);
            const imgData = tempCtx.getImageData(0, 0, tempCanvas.width, tempCanvas.height);
            const data = imgData.data;

            // Corner sample for background color detection
            const cornerR = data[0];
            const cornerG = data[1];
            const cornerB = data[2];

            const tolerance = 45;

            for (let i = 0; i < data.length; i += 4) {
                const r = data[i];
                const g = data[i + 1];
                const b = data[i + 2];

                // Distance from corner background color
                const diff = Math.sqrt(
                    Math.pow(r - cornerR, 2) +
                    Math.pow(g - cornerG, 2) +
                    Math.pow(b - cornerB, 2)
                );

                if (diff < tolerance) {
                    // Turn to pure white
                    data[i] = 255;
                    data[i + 1] = 255;
                    data[i + 2] = 255;
                }
            }

            // Put back & re-render
            photoCtx.putImageData(imgData, 0, 0);
            compressPhotoToTNPSCSize();
            showToast("பின்புலம் வெள்ளை நிறமாக மாற்றப்பட்டது!", "success");
        }

        function resetAdjustments() {
            document.getElementById('photo-zoom').value = 100;
            document.getElementById('photo-offset-x').value = 0;
            document.getElementById('photo-offset-y').value = 0;
            document.getElementById('zoom-val').textContent = '100%';
            document.getElementById('y-val').textContent = '0';
            renderPhoto();
            showToast("அமைப்புகள் மீட்டமைக்கப்பட்டன.", "info");
        }

        // ==========================================
        // DOWNLOAD HANDLERS
        // ==========================================
        function downloadPhoto() {
            if (!photoBlobData) {
                showToast("பதிவிறக்கம் செய்ய படம் தயாராக இல்லை!", "error");
                return;
            }
            const candidateName = (document.getElementById('photo-name-input').value || 'Candidate').trim().replace(/[^a-zA-Z0-9]/g, '_');
            const link = document.createElement('a');
            link.href = URL.createObjectURL(photoBlobData);
            link.download = `TNPSC_Photo_${candidateName}.jpg`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast("புகைப்படம் வெற்றிகரமாக பதிவிறக்கப்பட்டது!", "success");
        }

        function downloadSign() {
            if (!signBlobData) {
                showToast("கையெழுத்து படம் தயாராக இல்லை!", "error");
                return;
            }
            const link = document.createElement('a');
            link.href = URL.createObjectURL(signBlobData);
            link.download = `TNPSC_Signature.jpg`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast("கையெழுத்து வெற்றிகரமாக பதிவிறக்கப்பட்டது!", "success");
        }

        // Toast Helper
        function showToast(msg, type = "info") {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-msg');
            const toastIcon = document.getElementById('toast-icon');

            toastMsg.textContent = msg;

            if (type === 'success') {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400 text-lg";
            } else if (type === 'error') {
                toastIcon.className = "fa-solid fa-circle-xmark text-red-400 text-lg";
            } else {
                toastIcon.className = "fa-solid fa-circle-info text-blue-400 text-lg";
            }

            toast.classList.remove('translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3200);
        }

        // ==========================================
        // EVENT LISTENERS & INITIALIZATION
        // ==========================================
        window.addEventListener('DOMContentLoaded', () => {
            renderPhoto();
            renderSignaturePreview();

            // Photo Input Handling
            const photoInput = document.getElementById('photo-input');
            const photoDrop = document.getElementById('photo-drop-zone');

            photoDrop.addEventListener('click', () => photoInput.click());
            photoInput.addEventListener('change', (e) => {
                if (e.target.files && e.target.files[0]) {
                    loadFileToPhoto(e.target.files[0]);
                }
            });

            // Drag and Drop for Photo
            photoDrop.addEventListener('dragover', (e) => {
                e.preventDefault();
                photoDrop.classList.add('border-emerald-500', 'bg-emerald-50/50');
            });
            photoDrop.addEventListener('dragleave', () => {
                photoDrop.classList.remove('border-emerald-500', 'bg-emerald-50/50');
            });
            photoDrop.addEventListener('drop', (e) => {
                e.preventDefault();
                photoDrop.classList.remove('border-emerald-500', 'bg-emerald-50/50');
                if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                    loadFileToPhoto(e.dataTransfer.files[0]);
                }
            });

            function loadFileToPhoto(file) {
                const reader = new FileReader();
                reader.onload = (event) => {
                    const img = new Image();
                    img.onload = () => {
                        currentPhotoImg = img;
                        renderPhoto();
                        showToast("போட்டோ வெற்றிகரமாக சேர்க்கப்பட்டது!", "success");
                    };
                    img.src = event.target.result;
                };
                reader.readAsDataURL(file);
            }

            // Controls listeners
            document.getElementById('photo-name-input').addEventListener('input', renderPhoto);
            document.getElementById('photo-date-input').addEventListener('input', renderPhoto);
            document.getElementById('photo-res-select').addEventListener('change', renderPhoto);

            document.getElementById('photo-zoom').addEventListener('input', (e) => {
                document.getElementById('zoom-val').textContent = `${e.target.value}%`;
                renderPhoto();
            });

            document.getElementById('photo-offset-y').addEventListener('input', (e) => {
                document.getElementById('y-val').textContent = e.target.value;
                renderPhoto();
            });

            document.getElementById('photo-offset-x').addEventListener('input', renderPhoto);

            // Signature Input Handling
            const signInput = document.getElementById('sign-input');
            const signDrop = document.getElementById('sign-drop-zone');

            signDrop.addEventListener('click', () => signInput.click());
            signInput.addEventListener('change', (e) => {
                if (e.target.files && e.target.files[0]) {
                    const reader = new FileReader();
                    reader.onload = (event) => {
                        const img = new Image();
                        img.onload = () => {
                            currentSignImg = img;
                            renderSignaturePreview();
                            showToast("கையெழுத்து படம் சேர்க்கப்பட்டது!", "success");
                        };
                        img.src = event.target.result;
                    };
                    reader.readAsDataURL(e.target.files[0]);
                }
            });

            // Signature Contrast Slider & BW Filter
            document.getElementById('sign-threshold').addEventListener('input', (e) => {
                document.getElementById('sign-thresh-val').textContent = e.target.value;
                renderSignaturePreview();
            });
            document.getElementById('sign-bw-filter').addEventListener('change', renderSignaturePreview);

            // Signature Touch & Draw listeners
            function getPos(e) {
                const rect = signPad.getBoundingClientRect();
                const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                return {
                    x: clientX - rect.left,
                    y: clientY - rect.top
                };
            }

            function startDraw(e) {
                e.preventDefault();
                isDrawing = true;
                const pos = getPos(e);
                signPadCtx.beginPath();
                signPadCtx.moveTo(pos.x, pos.y);
            }

            function draw(e) {
                if (!isDrawing) return;
                e.preventDefault();
                const pos = getPos(e);
                signPadCtx.lineTo(pos.x, pos.y);
                signPadCtx.stroke();
            }

            function endDraw(e) {
                if (!isDrawing) return;
                isDrawing = false;
                renderSignaturePreview();
            }

            signPad.addEventListener('mousedown', startDraw);
            signPad.addEventListener('mousemove', draw);
            window.addEventListener('mouseup', endDraw);

            signPad.addEventListener('touchstart', startDraw, { passive: false });
            signPad.addEventListener('touchmove', draw, { passive: false });
            signPad.addEventListener('touchend', endDraw);
        });
    </script>
