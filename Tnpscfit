<!DOCTYPE html>
<html lang="ta">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TNPSC Group 4 Photo & Signature Resizer Tool</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Noto Sans Tamil -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+Tamil:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: 'Inter', 'Noto Sans Tamil', sans-serif;
        }
        .canvas-checkerboard {
            background-color: #f8fafc;
            background-image: 
                linear-gradient(45deg, #e2e8f0 25%, transparent 25%), 
                linear-gradient(-45deg, #e2e8f0 25%, transparent 25%), 
                linear-gradient(45deg, transparent 75%, #e2e8f0 75%), 
                linear-gradient(-45deg, transparent 75%, #e2e8f0 75%);
            background-size: 16px 16px;
            background-position: 0 0, 0 8px, 8px -8px, -8px 0px;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Header & Navigation -->
    <header class="bg-gradient-to-r from-emerald-800 via-teal-800 to-indigo-900 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center space-x-3">
                <div class="w-11 h-11 bg-white/10 rounded-xl flex items-center justify-center border border-white/20 text-yellow-300 text-xl font-bold">
                    <i class="fa-solid fa-file-shield"></i>
                </div>
                <div>
                    <h1 class="text-lg sm:text-xl font-bold tracking-tight">TNPSC Photo & Sign Resizer</h1>
                    <p class="text-xs text-emerald-200">குரூப் 4 & அரசுத் தேர்வுகளுக்கான அதிகாரப்பூர்வ பட அமைப்பாளர்</p>
                </div>
            </div>
            
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-200 border border-emerald-400/30">
                    <i class="fa-solid fa-circle-check mr-1.5 text-emerald-400"></i> 100% Free & Client-Side (பாதுகாப்பானது)
                </span>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
        
        <!-- TNPSC Rules Banner Alert -->
        <div class="mb-6 bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-2xl p-4 sm:p-5 shadow-sm">
            <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-lg bg-amber-500 text-white flex items-center justify-center shrink-0 mt-0.5">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div class="text-xs sm:text-sm text-amber-950">
                    <h2 class="font-bold text-sm sm:text-base text-amber-900 mb-1">TNPSC குரூப் 4 விதிமுறைகள் (Official Specifications):</h2>
                    <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 mt-2 font-medium">
                        <li class="flex items-center gap-2">
                            <i class="fa-solid fa-camera text-amber-700"></i>
                            <span><strong>புகைப்படம்:</strong> 3.5cm x 4.5cm (White Background), <strong>20 KB - 50 KB</strong>, பெயர் மற்றும் படம் எடுத்த தேதி கீழே இருக்க வேண்டும்.</span>
                        </li>
                        <li class="flex items-center gap-2">
                            <i class="fa-solid fa-signature text-amber-700"></i>
                            <span><strong>கையெழுத்து:</strong> 6.0cm x 2.0cm, <strong>10 KB - 20 KB</strong> (நீலம் அல்லது கருப்பு மை கொண்டு வெள்ளைத் தாளில் இட்டது).</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Tool Selection Tabs -->
        <div class="flex border-b border-slate-200 mb-6 gap-2">
            <button id="tab-photo-btn" onclick="switchTab('photo')" class="flex items-center gap-2.5 px-6 py-3 font-semibold text-sm rounded-t-xl transition-all border-b-2 border-emerald-600 bg-white text-emerald-700 shadow-sm">
                <i class="fa-regular fa-image text-emerald-600 text-base"></i> 1. புகைப்பட மாற்றி (Photo Tool)
            </button>
            <button id="tab-sign-btn" onclick="switchTab('sign')" class="flex items-center gap-2.5 px-6 py-3 font-semibold text-sm rounded-t-xl transition-all border-b-2 border-transparent text-slate-500 hover:text-slate-800 hover:bg-slate-100">
                <i class="fa-solid fa-pen-nib text-base"></i> 2. கையெழுத்து மாற்றி (Signature Tool)
            </button>
        </div>

        <!-- ==========================================
             SECTION 1: PHOTO GENERATOR & RESIZER
        ========================================== -->
        <section id="photo-section" class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- Controls Form Column -->
            <div class="lg:col-span-6 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h3 class="text-lg font-bold text-slate-800 mb-4 pb-2 border-b border-slate-100 flex items-center justify-between">
                    <span><i class="fa-solid fa-sliders text-emerald-600 mr-2"></i>புகைப்பட விவரங்கள்</span>
                    <span class="text-xs bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-md font-medium border border-emerald-200">அரசு தர அளவு</span>
                </h3>

                <!-- Upload Box -->
                <div class="mb-5">
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">1. உங்கள் புகைப்படத்தை தேர்ந்தெடுக்கவும்</label>
                    <div id="photo-drop-zone" class="border-2 border-dashed border-slate-300 hover:border-emerald-500 rounded-xl p-5 text-center cursor-pointer bg-slate-50 hover:bg-emerald-50/40 transition">
                        <input type="file" id="photo-input" accept="image/jpeg,image/png,image/webp,image/jpg" class="hidden">
                        <div class="flex flex-col items-center justify-center">
                            <i class="fa-solid fa-cloud-arrow-up text-3xl text-slate-400 mb-2"></i>
                            <p class="text-sm font-semibold text-slate-700">இங்கே கிளிக் செய்து போட்டோவை அப்லோடு செய்யவும்</p>
                            <p class="text-xs text-slate-400 mt-1">JPG, PNG அல்லது WebP (மொபைல் கேமரா போட்டோக்களும் ஏற்கப்படும்)</p>
                        </div>
                    </div>
                </div>

                <!-- Background Processing & White Fill -->
                <div class="mb-5 p-4 bg-slate-50 rounded-xl border border-slate-200">
                    <div class="flex items-center justify-between mb-3">
                        <div>
                            <span class="text-sm font-bold text-slate-800">வெள்ளை பின்புலம் (White Background)</span>
                            <p class="text-xs text-slate-500">TNPSC விதிப்படி பின்புலம் வெள்ளையாக மாற்றப்படும்</p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="photo-bg-white" checked class="sr-only peer">
                            <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600"></div>
                        </label>
                    </div>
                    
                    <div class="pt-2 border-t border-slate-200 flex flex-wrap gap-2 text-xs">
                        <button type="button" onclick="autoRemoveBackdrop()" class="px-3 py-1.5 bg-emerald-100 hover:bg-emerald-200 text-emerald-800 rounded-lg font-medium transition flex items-center gap-1.5">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> ஸ்மார்ட் பேக்ரவுண்ட் க்ளீனர் (AI Filter)
                        </button>
                        <button type="button" onclick="resetAdjustments()" class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 rounded-lg font-medium transition">
                            <i class="fa-solid fa-rotate-left mr-1"></i> ரீசெட் (Reset)
                        </button>
                    </div>
                </div>

                <!-- Candidate Name & Date of Photo -->
                <div class="space-y-4 mb-5">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">விண்ணப்பதாரர் பெயர் (Candidate Name in English)</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="fa-solid fa-user text-sm"></i>
                            </div>
                            <input type="text" id="photo-name-input" placeholder="e.g. M. KARTHIK" class="w-full pl-9 pr-3 py-2.5 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none uppercase font-semibold">
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">பெயரை ஆங்கிலத்தில் பெரிய எழுத்துக்களில் (CAPITAL LETTERS) உள்ளிடவும்.</p>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">புகைப்படம் எடுத்த தேதி (Date of Photo Taken)</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <i class="fa-solid fa-calendar-day text-sm"></i>
                            </div>
                            <input type="date" id="photo-date-input" class="w-full pl-9 pr-3 py-2.5 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none font-medium">
                        </div>
                        <p class="text-[11px] text-slate-400 mt-1">விளம்பர தேதிக்கு பிந்தைய சமீபத்திய தேதியை தேர்ந்தெடுக்கவும்.</p>
                    </div>
                </div>

                <!-- Image Position & Zoom Controls -->
                <div class="mb-5 p-3.5 bg-slate-50 rounded-xl border border-slate-200">
                    <span class="text-xs font-bold text-slate-700 uppercase tracking-wider block mb-2">போட்டோ அளவை சரிசெய்ய (Position & Zoom)</span>
                    <div class="grid grid-cols-2 gap-3 mb-2">
                        <div>
                            <div class="flex justify-between text-xs text-slate-500 mb-1">
                                <span>பெரிதாக்க (Zoom)</span>
                                <span id="zoom-val">100%</span>
                            </div>
                            <input type="range" id="photo-zoom" min="50" max="250" value="100" class="w-full accent-emerald-600">
                        </div>
                        <div>
                            <div class="flex justify-between text-xs text-slate-500 mb-1">
                                <span>மேல் / கீழ் (Y-Offset)</span>
                                <span id="y-val">0</span>
                            </div>
                            <input type="range" id="photo-offset-y" min="-120" max="120" value="0" class="w-full accent-emerald-600">
                        </div>
                    </div>
                    <div class="flex justify-between items-center text-xs text-slate-500">
                        <span>இடது / வலது (X-Offset)</span>
                        <input type="range" id="photo-offset-x" min="-100" max="100" value="0" class="w-1/2 accent-emerald-600">
                    </div>
                </div>

                <!-- TNPSC Standard Dimension Choice -->
                <div class="mb-5">
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">ரெசல்யூஷன் வகை (Dimension Specs)</label>
                    <select id="photo-res-select" class="w-full py-2.5 px-3 bg-white border border-slate-300 rounded-lg text-xs font-semibold focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                        <option value="standard" selected>3.5 cm x 4.5 cm (Standard 200 DPI - 276 x 354 px - பரிந்துரைக்கப்படுகிறது)</option>
                        <option value="portal">TNPSC Portal Min: 130 x 170 pixels</option>
                    </select>
                </div>
            </div>

            <!-- Preview & Download Column -->
            <div class="lg:col-span-6 flex flex-col items-center">
                <div class="sticky top-24 w-full bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col items-center">
                    <div class="w-full flex items-center justify-between pb-3 mb-4 border-b border-slate-100">
                        <span class="text-sm font-bold text-slate-700 flex items-center gap-2">
                            <i class="fa-solid fa-eye text-emerald-600"></i> நேரடி முன்னோட்டம் (Live Preview)
                        </span>
                        <span id="photo-spec-pill" class="text-xs px-2.5 py-1 bg-emerald-50 text-emerald-700 font-bold rounded border border-emerald-200">
                            இலக்கு: 20 KB - 50 KB
                        </span>
                    </div>

                    <!-- Canvas Container -->
                    <div class="p-3 bg-slate-100 rounded-2xl border border-slate-200 shadow-inner flex justify-center items-center">
                        <div class="canvas-checkerboard p-1 rounded-xl shadow-md border border-slate-300">
                            <!-- Official TNPSC Canvas (Aspect ratio 3.5 : 4.5) -->
                            <canvas id="photo-canvas" class="rounded block bg-white" width="276" height="354" style="max-height: 380px; width: auto;"></canvas>
                        </div>
                    </div>

                    <!-- Live File Size Indicator -->
                    <div class="w-full mt-4 bg-slate-50 p-3 rounded-xl border border-slate-200">
                        <div class="flex items-center justify-between text-xs font-semibold mb-1">
                            <span class="text-slate-600">உருவாக்கப்பட்ட கோப்பு அளவு (File Size):</span>
                            <span id="photo-size-badge" class="px-2 py-0.5 rounded text-xs font-bold bg-amber-100 text-amber-800">
                                0 KB
                            </span>
                        </div>
                        <!-- Progress bar -->
                        <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                            <div id="photo-size-progress" class="bg-emerald-600 h-full w-0 transition-all duration-300"></div>
                        </div>
                        <p id="photo-size-msg" class="text-[11px] text-slate-500 mt-1">
                            புகைப்படம் தயார் ஆனவுடன் TNPSC வரம்பான 20 KB - 50 KB சரிபார்க்கப்படும்.
                        </p>
                    </div>

                    <!-- Download Button -->
                    <button type="button" id="photo-download-btn" onclick="downloadPhoto()" class="w-full mt-5 py-3.5 px-4 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-bold rounded-xl shadow-md hover:shadow-lg transition flex items-center justify-center gap-2 text-sm disabled:opacity-50 disabled:cursor-not-allowed">
                        <i class="fa-solid fa-download"></i> போட்டோவை பதிவிறக்கம் செய் (Download JPG)
                    </button>
                    <p class="text-center text-xs text-slate-400 mt-2">
                        அரசு போர்ட்டலில் நேராக பதிவேற்றக்கூடிய தரத்தில் பதிவிறக்கப்படும்.
                    </p>
                </div>
            </div>
        </section>

        <!-- ==========================================
             SECTION 2: SIGNATURE GENERATOR & RESIZER
        ========================================== -->
        <section id="sign-section" class="hidden grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- Signature Controls Column -->
            <div class="lg:col-span-6 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h3 class="text-lg font-bold text-slate-800 mb-4 pb-2 border-b border-slate-100 flex items-center justify-between">
                    <span><i class="fa-solid fa-file-signature text-emerald-600 mr-2"></i>கையெழுத்து விவரங்கள்</span>
                    <span class="text-xs bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-md font-medium border border-emerald-200">அரசு தர அளவு: 10KB - 20KB</span>
                </h3>

                <!-- Upload Mode Toggle -->
                <div class="grid grid-cols-2 gap-2 mb-4 bg-slate-100 p-1 rounded-xl">
                    <button type="button" id="sign-mode-upload" onclick="setSignMode('upload')" class="py-2 text-xs font-bold rounded-lg bg-white shadow-sm text-emerald-700 transition">
                        <i class="fa-solid fa-upload mr-1"></i> ஃபைல் அப்லோடு
                    </button>
                    <button type="button" id="sign-mode-draw" onclick="setSignMode('draw')" class="py-2 text-xs font-semibold rounded-lg text-slate-600 hover:text-slate-900 transition">
                        <i class="fa-solid fa-signature mr-1"></i> திரையில் கையெழுத்திட
                    </button>
                </div>

                <!-- Sign Upload Box -->
                <div id="sign-upload-container" class="mb-5">
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">கையெழுத்துப் படத்தை தேர்ந்தெடுக்கவும்</label>
                    <div id="sign-drop-zone" class="border-2 border-dashed border-slate-300 hover:border-emerald-500 rounded-xl p-5 text-center cursor-pointer bg-slate-50 hover:bg-emerald-50/40 transition">
                        <input type="file" id="sign-input" accept="image/jpeg,image/png,image/webp,image/jpg" class="hidden">
                        <div class="flex flex-col items-center justify-center">
                            <i class="fa-solid fa-pen-fancy text-3xl text-slate-400 mb-2"></i>
                            <p class="text-sm font-semibold text-slate-700">வெள்ளைத் தாளில் இட்ட கையெழுத்தை அப்லோடு செய்</p>
                            <p class="text-xs text-slate-400 mt-1">மொபைல் கேமரா அல்லது ஸ்கேன் செய்யப்பட்ட படம்</p>
                        </div>
                    </div>
                </div>

                <!-- Sign Drawing Box -->
                <div id="sign-draw-container" class="mb-5 hidden">
                    <div class="flex justify-between items-center mb-1">
                        <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">கீழே உள்ள கட்டத்தில் கையெழுத்திடுங்கள்</label>
                        <button type="button" onclick="clearSignaturePad()" class="text-xs text-red-600 hover:underline font-semibold">
                            <i class="fa-solid fa-eraser mr-1"></i> அழிக்க (Clear)
                        </button>
                    </div>
                    <canvas id="sign-pad" class="w-full border-2 border-slate-300 rounded-xl bg-white cursor-crosshair h-36 touch-none"></canvas>
                    <p class="text-[11px] text-slate-400 mt-1">விரல் அல்லது ஸ்டைலஸ் (Touch / Mouse) பயன்படுத்தி கையெழுத்திடலாம்.</p>
                </div>

                <!-- Ink Filter & Contrast Controls -->
                <div class="mb-5 p-4 bg-slate-50 rounded-xl border border-slate-200">
                    <span class="text-xs font-bold text-slate-700 uppercase tracking-wider block mb-3">கையெழுத்தை தூய்மையாக்கும் அமைப்புகள் (Enhancements)</span>
                    
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-semibold text-slate-700">தெளிவான கறுப்பு மை மாற்றி (B&W Filter)</span>
                        <input type="checkbox" id="sign-bw-filter" checked class="w-4 h-4 accent-emerald-600 rounded">
                    </div>

                    <div class="space-y-3">
                        <div>
                            <div class="flex justify-between text-xs text-slate-500 mb-1">
                                <span>இருண்மை & தெளிவு (Contrast/Threshold)</span>
                                <span id="sign-thresh-val">150</span>
                            </div>
                            <input type="range" id="sign-threshold" min="60" max="220" value="150" class="w-full accent-emerald-600">
                        </div>
                    </div>
                </div>

                <!-- Dimension Details -->
                <div class="p-3.5 bg-blue-50 border border-blue-200 rounded-xl text-xs text-blue-900">
                    <p class="font-bold flex items-center gap-1.5 mb-1">
                        <i class="fa-solid fa-circle-info text-blue-600"></i> TNPSC கையெழுத்து அளவு விபரம்:
                    </p>
                    <p>அளவு: <strong>6.0 cm x 2.0 cm (230 x 75 Pixels)</strong>. கோப்பு அளவு <strong>10 KB முதல் 20 KB வரை</strong> மிகச் சரியாக சுருக்கப்படும்.</p>
